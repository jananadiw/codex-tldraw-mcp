{
  "name": "codex-tldraw-mcp",
  "version": "0.7.0",
  "mcpName": "io.github.jananadiw/codex-tldraw-mcp",
  "description": "A stdio MCP server for repo-local tldraw diagrams, portable SVG previews, and code graph drift detection.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "codex-tldraw-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    ".agents/plugins",
    ".codex-plugin",
    ".mcp.json",
    "CHANGELOG.md",
    "assets/icon-dark.svg",
    "assets/icon.svg",
    "dist",
    "docs/architecture-diagrams.md",
    "docs/release-v0.1.1.md",
    "docs/release-v0.2.0.md",
    "docs/release-v0.2.1.md",
    "docs/release-v0.3.0.md",
    "docs/release-v0.4.0.md",
    "docs/release-v0.5.0.md",
    "docs/release-v0.6.0.md",
    "docs/release-v0.7.0.md",
    "launcher.js",
    "prepare.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json",
    "package.json"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "bun run build:ui && bun run build:server && bun run typecheck:app",
    "build:server": "tsc -p tsconfig.json && tsc -p tsconfig.check.json --noEmit",
    "build:ui": "vite build --logLevel error",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "dev": "bun src/index.ts",
    "check:package": "bun scripts/checkPackage.ts",
    "smoke": "bun scripts/smoke.ts && bun scripts/codeGraphSmoke.ts && bun scripts/architectureSmoke.ts",
    "test": "bun run smoke",
    "prepack": "bun run build",
    "prepare": "node prepare.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tldraw",
    "codex",
    "codex-desktop",
    "mcp-server",
    "developer-tools",
    "repo-visualization",
    "codebase-visualization",
    "code-graph",
    "dependency-graph",
    "diagram-drift",
    "architecture-diagrams",
    "workflow-diagrams",
    "codex-mcp"
  ],
  "homepage": "https://github.com/jananadiw/codex-tldraw-mcp#readme",
  "bugs": {
    "url": "https://github.com/jananadiw/codex-tldraw-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jananadiw/codex-tldraw-mcp.git"
  },
  "author": "jananadiw",
  "maintainers": [
    "jananadiw"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tldraw": "^5.1.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openai/mcp-extensions": "0.1.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
